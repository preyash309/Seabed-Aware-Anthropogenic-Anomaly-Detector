# Set this to an external directory containing the five original assets at
# the relative paths in config/model_manifest.json. Never copy weights into Git.
SAAD_ARTIFACT_DIR=E:/SIH/SIH_Results

# Optional individual overrides. A replacement must match the manifest hash.
# SAAD_YOLO_WEIGHTS=
# SAAD_VAE_WEIGHTS=
# SAAD_FLOW_WEIGHTS=
# SAAD_LATENT_MEAN=
# SAAD_LATENT_STD=
# SAAD_MODEL_MANIFEST=
# SAAD_CALIBRATION_FILE=

# Optional read-only prepared dataset location; inference does not require it.
# SAAD_DATASET_DIR=E:/SIH/Datasets/SAAD_baseline

# These defaults resolve under the clean repository.
SAAD_UPLOAD_DIR=var/uploads
SAAD_OUTPUT_DIR=var/results
SAAD_API_PUBLIC_URL=http://127.0.0.1:8000
SAAD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAAD_DEVICE=auto
VITE_API_BASE_URL=http://127.0.0.1:8000
